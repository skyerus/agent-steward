{
  "id": "sable-integration-review",
  "name": "Sable integration review",
  "description": "Reviews integration calls against the admitted Discord turn and authorizes the broker call once.",
  "contracts": { "tools": ["manage_schedule"] },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["speakers"],
    "properties": {
      "reviewerModel": { "type": "string", "minLength": 3, "maxLength": 128 },
      "reviewerAgentId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
      "speakers": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]+$" } },
      "speakerChannels": {
        "type": "object",
        "propertyNames": { "pattern": "^[0-9]{16,22}$" },
        "additionalProperties": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{16,22}$" } }
      }
    }
  }
}
